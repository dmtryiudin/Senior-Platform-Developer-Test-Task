# Copy to .env to override defaults (read by docker compose).

# Backend (NestJS) port. If you change it, update NEXT_PUBLIC_API_URL below to match.
PORT=3001

# Backend URL as seen from the browser (used by the Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend URL as seen from the browser; the only origin the backend allows via CORS
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL credentials (the backend's DATABASE_URL is built from these in docker-compose.yml)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
